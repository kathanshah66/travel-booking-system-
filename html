                <h2>Traveler Stories</h2>
            </div>
            <div class="testimonials-grid" id="testimonialsGrid"></div>
        </div>
    </section>
    <section class="newsletter-section">
        <div class="container">
            <h2>Subscribe for ₹ Offers</h2>
