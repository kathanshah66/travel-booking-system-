            <div class="footer-bottom">
                <p>© 2025 Travel Explorer - All prices in Indian Rupees (₹)</p>
            </div>
        </div>
    </footer>

    <!-- Auth Modal -->
    <div id="authModal" class="modal">
        <div class="modal-overlay"></div>
        <div class="modal-container">
            <div class="auth-tabs"><button class="auth-tab active" data-tab="login">Login</button><button
                    class="auth-tab" data-tab="register">Register</button><i class="fas fa-times"
                    style="margin-left:auto; cursor:pointer;" id="closeModal"></i></div>
            <div id="loginForm" class="auth-form active">
                <div class="form-group"><label>Email</label>
                    <div class="input-icon"><i class="fas fa-envelope"></i><input type="email" id="loginEmail"
                            placeholder="you@example.com"></div>
                </div>
                <div class="form-group"><label>Password</label>
                    <div class="input-icon"><i class="fas fa-lock"></i><input type="password" id="loginPassword"
                            placeholder="••••••"><button class="show-pwd" type="button">👁️</button></div>
                </div>
                <div class="form-options"><label><input type="checkbox" id="rememberMe"> Remember me</label><a href="#"
                        id="forgotLink" style="color:var(--primary-color);">Forgot?</a></div>
                <button class="btn btn-primary btn-block" id="doLogin">Login</button>
                <div class="social-auth"><button class="btn-social google" id="googleDemo"><i class="fab fa-google"></i>
                        Demo Google</button></div>
            </div>
            <div id="registerForm" class="auth-form">
                <div class="form-group"><label>Full Name</label>
                    <div class="input-icon"><i class="fas fa-user"></i><input type="text" id="regName"
                            placeholder="John Doe"></div>
                </div>
                <div class="form-group"><label>Email</label>
                    <div class="input-icon"><i class="fas fa-envelope"></i><input type="email" id="regEmail"
                            placeholder="you@example.com"></div>
                </div>
                <div class="form-group"><label>Password</label>
                    <div class="input-icon"><i class="fas fa-lock"></i><input type="password" id="regPassword"
                            placeholder="Min 6 chars"><button class="show-pwd" type="button">👁️</button></div>
                </div>
                <div class="form-group"><label>Confirm Password</label>
                    <div class="input-icon"><i class="fas fa-check-circle"></i><input type="password" id="regConfirm">
                    </div>
                </div>
                <button class="btn btn-primary btn-block" id="doRegister">Create Account</button>
            </div>
        </div>
    </div>

    <script>
        // ---------- CONVERT USD to INR (1 USD = 85 INR approx, round to nearest 100 for realism) ----------
        const toINR = (usd) => `₹${Math.round(usd * 85 / 100) * 100}`;

        const packages = [
            { id: 1, name: "Bali Beach Escape", type: "basic", usd: 499, desc: "4 days beachfront", features: ["3-Star Hotel", "Breakfast", "Flights"], rating: 4.2, img: "https://picsum.photos/id/15/400/250", badge: "Basic" },
            { id: 2, name: "Paris Romance Tour", type: "standard", usd: 1299, desc: "6 days guided tours", features: ["4-Star Hotel", "Breakfast+Dinner", "Guided Tours"], rating: 4.7, img: "https://picsum.photos/id/30/400/250", badge: "Standard" },
            { id: 3, name: "Maldives Luxury", type: "premium", usd: 3999, desc: "Overwater bungalows", features: ["5-Star Resort", "All Inclusive", "Spa"], rating: 5.0, img: "https://picsum.photos/id/104/400/250", badge: "Premium" },
            { id: 4, name: "Thailand Explorer", type: "basic", usd: 599, desc: "Bangkok & temples", features: ["3-Star Hotel", "Breakfast", "Local tours"], rating: 4.0, img: "https://picsum.photos/id/88/400/250", badge: "Basic" },
            { id: 5, name: "Japan Cherry Blossom", type: "standard", usd: 2199, desc: "Tokyo-Kyoto", features: ["4-Star Hotels", "Bullet Train", "Meals"], rating: 4.9, img: "https://picsum.photos/id/22/400/250", badge: "Standard" },
            { id: 6, name: "Kenya Safari", type: "premium", usd: 5499, desc: "Luxury wildlife", features: ["Luxury Lodges", "Private Jeep", "Photographer"], rating: 5.0, img: "https://picsum.photos/id/29/400/250", badge: "Premium" }
        ];
        const destinations = [{ name: "Goa, India", tag: "Beaches & parties", img: "https://picsum.photos/id/106/400/300" }, { name: "Manali", tag: "Mountain adventure", img: "https://picsum.photos/id/29/400/300" }, { name: "Kerala Backwaters", tag: "Houseboats", img: "https://picsum.photos/id/13/400/300" }, { name: "Jaipur", tag: "Royal heritage", img: "https://picsum.photos/id/10/400/300" }];
        const testimonials = [{ name: "Riya Sharma", text: "Amazing experience! Paid in ₹, no hidden charges.", img: "https://randomuser.me/api/portraits/women/68.jpg" }, { name: "Aditya K.", text: "Maldives package was dreamy. Support in Hindi was great!", img: "https://randomuser.me/api/portraits/men/32.jpg" }];

        function renderPackages(filter = "all") {
            const grid = document.getElementById("packagesGrid");
            const filtered = filter === "all" ? packages : packages.filter(p => p.type === filter);
            grid.innerHTML = filtered.map(p => `<div class="package-card" data-type="${p.type}"><div class="package-badge ${p.type}">${p.badge}</div><div class="package-image" style="background-image:url('${p.img}');"><div class="package-price">${toINR(p.usd)}<span>/person</span></div></div><div class="package-content"><div class="package-rating">${'★'.repeat(Math.floor(p.rating))} (${p.rating})</div><h3>${p.name}</h3><p>${p.desc}</p><div class="package-features">${p.features.map(f => `<span><i class="fas fa-check-circle"></i> ${f}</span>`).join('')}</div><div class="package-actions"><button class="btn btn-outline detailsBtn" data-id="${p.id}">Details</button><button class="btn btn-primary bookBtn" data-id="${p.id}">Book Now ₹</button></div></div></div>`).join('');
            document.querySelectorAll('.bookBtn').forEach(btn => btn.addEventListener('click', (e) => { const id = parseInt(btn.dataset.id); handleBooking(id); }));
            document.querySelectorAll('.detailsBtn').forEach(btn => btn.addEventListener('click', (e) => { const pkg = packages.find(p => p.id == btn.dataset.id); showToast(`📋 ${pkg.name}: ${pkg.desc} | Price ${toINR(pkg.usd)}`, "info"); }));
        }
        function handleBooking(pkgId) {
            const user = localStorage.getItem("travelUser");
            if (!user) { showToast("Please login to book", "warning"); openAuthModal(); return; }
            const pkg = packages.find(p => p.id === pkgId);
            showToast(`✅ Booked ${pkg.name} for ${toINR(pkg.usd)}! (demo)`, "success");
        }
        function showToast(msg, type = "info") { let t = document.createElement('div'); t.className = "toast"; t.style.background = type === "success" ? "#2e7d32" : "#d32f2f"; t.innerText = msg; document.body.appendChild(t); setTimeout(() => t.remove(), 3000); }

        // Auth logic with localStorage
        function isLoggedIn() { return !!localStorage.getItem("travelUser"); }
        function updateAuthUI() {
            const user = localStorage.getItem("travelUser");
            const authDiv = document.getElementById("authButtons");
            if (user && authDiv) {
                let userName = JSON.parse(user).name || "User";
                authDiv.innerHTML = `<span style="display:flex;gap:10px;align-items:center;"><i class="fas fa-user-circle"></i> ${userName}<button id="logoutBtnNav" class="btn btn-outline" style="padding:6px 12px;">Logout</button></span>`;
                document.getElementById("logoutBtnNav")?.addEventListener("click", () => { localStorage.removeItem("travelUser"); showToast("Logged out", "success"); updateAuthUI(); });
            } else if (authDiv) {
                authDiv.innerHTML = `<button class="btn btn-login" id="loginBtnModal"><i class="fas fa-sign-in-alt"></i> Login</button><button class="btn btn-primary" id="signupBtnModal"><i class="fas fa-user-plus"></i> Sign Up</button>`;
                document.getElementById("loginBtnModal")?.addEventListener("click", openAuthModal);
                document.getElementById("signupBtnModal")?.addEventListener("click", openAuthModal);
            }
        }
        const modal = document.getElementById("authModal");
        function openAuthModal() { modal.classList.add("active"); }
        function closeAuthModal() { modal.classList.remove("active"); }
        document.getElementById("closeModal")?.addEventListener("click", closeAuthModal);
        document.querySelector(".modal-overlay")?.addEventListener("click", closeAuthModal);
        // tab切换
        document.querySelectorAll(".auth-tab").forEach(tab => { tab.addEventListener("click", (e) => { const target = tab.dataset.tab; document.querySelectorAll(".auth-tab").forEach(t => t.classList.remove("active")); tab.classList.add("active"); document.getElementById("loginForm").classList.toggle("active", target === "login"); document.getElementById("registerForm").classList.toggle("active", target === "register"); }); });
        // password show
        document.querySelectorAll(".show-pwd").forEach(btn => { btn.addEventListener("click", function () { let input = this.previousElementSibling; if (input.type === "password") input.type = "text"; else input.type = "password"; }); });
        // Register
        document.getElementById("doRegister")?.addEventListener("click", () => {
            let name = document.getElementById("regName").value.trim();
            let email = document.getElementById("regEmail").value.trim();
            let pwd = document.getElementById("regPassword").value;
            let confirm = document.getElementById("regConfirm").value;
            if (!name || !email || !pwd) { showToast("All fields required", "warning"); return; }
            if (pwd !== confirm) { showToast("Passwords do not match", "error"); return; }
            if (pwd.length < 6) { showToast("Password min 6 chars", "warning"); return; }
            const userObj = { name, email, password: pwd };
            localStorage.setItem("travelUser", JSON.stringify(userObj));
            showToast(`Welcome ${name}! Registration successful`, "success");
            closeAuthModal();
            updateAuthUI();
        });
        // Login
        document.getElementById("doLogin")?.addEventListener("click", () => {
            let email = document.getElementById("loginEmail").value.trim();
            let pwd = document.getElementById("loginPassword").value;
            let stored = localStorage.getItem("travelUser");
            if (stored) {
                let user = JSON.parse(stored);
                if (user.email === email && user.password === pwd) {
                    showToast(`Welcome back ${user.name}`, "success");
                    closeAuthModal();
                    updateAuthUI();
                    return;
                }
            }
            // demo fallback: create if not exist? but strict: show error
            showToast("Invalid credentials. Please register first", "error");
        });
        document.getElementById("googleDemo")?.addEventListener("click", () => {
            let demo = { name: "Guest User", email: "guest@demo.com", password: "demo123" };
            localStorage.setItem("travelUser", JSON.stringify(demo));
            showToast("Demo login successful (Guest)", "success");
            closeAuthModal();
            updateAuthUI();
        });
        document.getElementById("forgotLink")?.addEventListener("click", (e) => { e.preventDefault(); showToast("Reset link sent to email (demo)", "info"); });

        // filter tabs and hero search
        document.querySelectorAll(".tab-btn").forEach(btn => { btn.addEventListener("click", function () { document.querySelectorAll(".tab-btn").forEach(b => b.classList.remove("active")); this.classList.add("active"); renderPackages(this.dataset.cat); }); });
        document.getElementById("heroSearchBtn")?.addEventListener("click", () => {
            let searchTerm = document.getElementById("heroSearch").value.toLowerCase();
            let type = document.getElementById("heroType").value;
            let filtered = packages.filter(p => (type === "" || p.type === type) && (searchTerm === "" || p.name.toLowerCase().includes(searchTerm)));
            const grid = document.getElementById("packagesGrid");
            if (filtered.length === 0) { showToast("No packages found", "info"); }
            else {
                grid.innerHTML = filtered.map(p => `<div class="package-card"><div class="package-badge ${p.type}">${p.badge}</div><div class="package-image" style="background-image:url('${p.img}');"><div class="package-price">${toINR(p.usd)}</div></div><div class="package-content"><h3>${p.name}</h3><button class="btn btn-primary bookBtn" data-id="${p.id}">Book Now</button></div></div>`).join('');
                document.querySelectorAll('.bookBtn').forEach(btn => btn.addEventListener('click', (e) => { const id = parseInt(btn.dataset.id); handleBooking(id); }));
            }
        });

        function renderDestinations() { const grid = document.getElementById("destinationsGrid"); grid.innerHTML = destinations.map(d => `<div class="destination-card"><div class="destination-image" style="background-image:url('${d.img}');"></div><div class="destination-overlay"><h3>${d.name}</h3><p>${d.tag}</p></div></div>`).join(''); }
        function renderTestimonials() { const grid = document.getElementById("testimonialsGrid"); grid.innerHTML = testimonials.map(t => `<div class="testimonial-card"><p>“${t.text}”</p><div class="testimonial-author"><img src="${t.img}"><h4>${t.name}</h4></div></div>`).join(''); }
        document.getElementById("newsForm")?.addEventListener("submit", (e) => { e.preventDefault(); showToast("Subscribed to ₹ offers!", "success"); e.target.reset(); });
        // mobile menu toggle
        document.querySelector(".mobile-menu")?.addEventListener("click", () => { document.querySelector(".nav-links").classList.toggle("active"); });
        document.getElementById("navPackages")?.addEventListener("click", (e) => { e.preventDefault(); document.getElementById("packagesSection").scrollIntoView({ behavior: "smooth" }); });
        document.getElementById("navDestinations")?.addEventListener("click", (e) => { e.preventDefault(); document.querySelector(".destinations-section").scrollIntoView({ behavior: "smooth" }); });
        document.getElementById("navContact")?.addEventListener("click", (e) => { e.preventDefault(); showToast("📞 +91 98765 43210 | Email: care@travelexplorer.in", "info"); });

        renderPackages("all");
        renderDestinations();
        renderTestimonials();
        updateAuthUI();
        // attach modal buttons
        if (document.getElementById("loginBtnModal")) document.getElementById("loginBtnModal").addEventListener("click", openAuthModal);
        if (document.getElementById("signupBtnModal")) document.getElementById("signupBtnModal").addEventListener("click", openAuthModal);
    </script>
</body>

</html>