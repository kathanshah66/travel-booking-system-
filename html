        </div>
    </nav>

    <section class="hero">
        <div class="hero-overlay"></div>
        <div class="container">
            <div class="hero-content">
                <h1 class="hero-title">भारत की यात्रा करें ✈️</h1>
                <p class="hero-subtitle">Discover amazing places with prices in Indian Rupees (₹). Zero hidden fees.</p>
                <div class="hero-search">
                    <input type="text" id="heroSearch" placeholder="Where to?" class="search-input">
                    <select id="heroType" class="search-select">
                        <option value="">Package Type</option>
                        <option value="basic">Basic</option>
                        <option value="standard">Standard</option>
                        <option value="premium">Premium</option>
                    </select>
                    <input type="date" class="search-date" id="heroDate">
                    <button id="heroSearchBtn" class="btn btn-primary"><i class="fas fa-search"></i> Search</button>
                </div>
                <div class="hero-stats">
                    <div class="stat">
                        <h3>150+</h3>
                        <p>Destinations</p>
                    </div>
                    <div class="stat">
                        <h3>5000+</h3>
                        <p>Happy Travelers</p>
                    </div>
                    <div class="stat">
                        <h3>24/7</h3>
                        <p>Support in ₹</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="packages-section" id="packagesSection">
        <div class="container">
            <div class="section-header">
                <h2>Featured Travel Packages (₹ Prices)</h2>
                <p>Best deals curated for Indian travelers</p>
            </div>
            <div class="package-tabs"><button class="tab-btn active" data-cat="all">All</button><button class="tab-btn"
                    data-cat="basic">Basic</button><button class="tab-btn" data-cat="standard">Standard</button><button
                    class="tab-btn" data-cat="premium">Premium</button></div>
            <div class="packages-grid" id="packagesGrid"></div>
        </div>
    </section>

    <section class="destinations-section">
        <div class="container">
            <div class="section-header">
                <h2>Popular Destinations</h2>
            </div>
            <div class="destinations-grid" id="destinationsGrid"></div>
        </div>
    </section>
    <section class="features-section">
        <div class="container">
            <div class="section-header">
                <h2>Why Travel Explorer?</h2>
            </div>
            <div class="features-grid">
                <div class="feature-card">
                    <div class="feature-icon"><i class="fas fa-rupee-sign"></i></div>
